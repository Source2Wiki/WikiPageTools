<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="9.0.6" />
    <PackageReference Include="ValveResourceFormat" Version="20.0.6980" />
    <PackageReference Include="ValveResourceFormat.Renderer" Version="20.0.6980" />
    <PackageReference Include="OpenTK" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- lights the rendered model icons, this is the cubemap Source2Viewer lights its thumbnails with -->
    <EmbeddedResource Include="industrial_sunset_puresky.vtex_c" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sledge.Formats.GameData\Sledge.Formats.GameData.csproj" />
  </ItemGroup>

</Project>
